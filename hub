<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>HTML5 Game Archive</title>
  <style>
    body {
      background: #0f0f0f;
      color: #eaeaea;
      font-family: Arial, sans-serif;
      padding: 40px;
    }
    h1 {
      margin-bottom: 10px;
    }
    p {
      color: #aaa;
    }
    ul {
      list-style: none;
      padding: 0;
      margin-top: 30px;
    }
    li {
      margin: 8px 0;
    }
    a {
      color: #4da6ff;
      text-decoration: none;
      font-size: 18px;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

<h1>HTML5 Game Archive</h1>
<p>Click a game to play.</p>

<ul id="games"></ul>

<script>
const user = "counterofdays";
const repo = "educatingtheworld";
const path = "games";

fetch(`https://api.github.com/repos/${user}/${repo}/contents/${path}`)
  .then(res => res.json())
  .then(items => {
    const list = document.getElementById("games");

    items
      .filter(item => item.type === "dir")
      .forEach(item => {
        const li = document.createElement("li");
        const a = document.createElement("a");

        a.href = `/educatingtheworld/games/${item.name}/`;
        a.textContent = item.name.replace(/-/g, " ");

        li.appendChild(a);
        list.appendChild(li);
      });
  })
  .catch(err => {
    console.error("Failed to load games", err);
  });
</script>

</body>
</html>
